{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update fully-qualified OCI image references in TypeScript sources",
      "managerFilePatterns": ["/^(extensions|packages)/.+\\.ts$/"],
      "matchStrings": [
        "['\"`](?<depName>[a-z0-9][a-z0-9.-]*\\.[a-z]{2,}(?::[0-9]+)?/[a-z0-9._/-]+):(?<currentValue>[A-Za-z0-9_][A-Za-z0-9._-]{0,127})(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?['\"`]",
        "['\"`](?<depName>[a-z0-9][a-z0-9.-]*\\.[a-z]{2,}(?::[0-9]+)?/[a-z0-9._/-]+)@(?<currentDigest>sha256:[a-f0-9]{64})['\"`]"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Ignore image references by default: most of them are test fixtures",
      "matchManagers": ["custom.regex"],
      "enabled": false
    },
    {
      "description": "Images actually used by Kaiden at runtime",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": [
        "ghcr.io/openkaiden/**",
        "ghcr.io/nvidia/openshell/**",
        "quay.io/docling-project/**",
        "docker.io/milvusdb/**"
      ],
      "enabled": true
    }
  ]
}
